DATABASE_URL=postgresql://rosmarium:rosmarium@localhost:5432/rosmarium
REDIS_URL=redis://localhost:6379
STORAGE_PROVIDER=minio
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=rosmarium-assets
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=rosmarium
STORAGE_SECRET_KEY=rosmarium_secret
SESSION_SECRET=change-this-to-a-random-256-bit-hex-string-in-production
ADMIN_EMAIL=admin@rosmarium.local
ADMIN_PASSWORD=rosmarium_dev_password
AI_WORKER_URL=http://localhost:8001
AI_WORKER_SECRET=change-this-in-production
PORT=3000
NODE_ENV=development
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
OLLAMA_BASE_URL=http://localhost:11434
# AI Intelligence settings
TAGGING_MODEL=cross-encoder/nli-MiniLM2-L6-H768
SUMMARIZATION_MODEL=llama3.2
DUPLICATE_THRESHOLD=0.92

# Additional required configuration
HOST=0.0.0.0
WORKER_SECRET=change-this-in-production
EMBEDDING_DIMENSIONS=768
EMBEDDING_BATCH_SIZE=32
EMBEDDING_QUEUE_CONCURRENCY=4
OPENAI_API_KEY=
COHERE_API_KEY=
HF_API_KEY=
CHUNKING_DEFAULT_STRATEGY=sentence
CHUNKING_CHUNK_SIZE=512
CHUNKING_CHUNK_OVERLAP=50
GRAPH_INFERENCE_ENABLED=true
GRAPH_SIMILARITY_THRESHOLD=0.85
GRAPH_MAX_SIMILARITY_EDGES=5
