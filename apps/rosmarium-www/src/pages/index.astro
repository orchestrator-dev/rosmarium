---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Rosmarium COS | The AI-Native Revolution">
  {/* Hero Section */}
  <section class="relative pt-32 pb-20 overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-neon-purple/20 via-dark-bg to-dark-bg -z-10"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="inline-block px-4 py-1.5 rounded-full border border-neon-cyan/30 bg-neon-cyan/5 text-neon-cyan text-sm font-semibold tracking-wide mb-6">
        THE ENTERPRISE HEADLESS CMS
      </div>
      <h1 class="text-5xl md:text-7xl font-extrabold tracking-tight text-white mb-6 leading-tight">
        Accelerate Content Velocity. <br class="hidden md:block"/>
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-neon-cyan to-neon-purple">Eliminate Bottlenecks.</span>
      </h1>
      <p class="text-xl md:text-2xl text-zinc-400 max-w-3xl mx-auto mb-10 font-light leading-relaxed">
        Empower marketing teams to ship personalized, omnichannel campaigns instantly—without waiting on engineering. Rosmarium unifies content, native AI, and automated workflows into one seamless platform.
      </p>
      <div class="flex flex-col sm:flex-row justify-center gap-4 mb-20">
        <a href="https://demo.rosmarium.com" target="_blank" rel="noopener noreferrer" class="inline-flex justify-center items-center px-8 py-4 text-base font-bold text-white bg-neon-purple rounded-lg hover:bg-neon-purple/90 transition-all shadow-[0_0_20px_rgba(168,85,247,0.4)]">
          Start Interactive Demo
        </a>
        <a href="/docs" class="inline-flex justify-center items-center px-8 py-4 text-base font-semibold text-white bg-dark-surface border border-dark-border rounded-lg hover:bg-zinc-800 transition-all">
          Read Documentation
        </a>
      </div>
      
      {/* Ecosystem Readiness */}
      <div class="mb-20 pt-10 border-t border-dark-border/50 max-w-5xl mx-auto">
        <p class="text-sm font-medium text-zinc-500 uppercase tracking-widest mb-8 text-center">Ready for the current and future digital ecosystem</p>
        <div class="flex flex-wrap justify-center items-center gap-6 md:gap-10 text-zinc-400 font-semibold">
          <div class="flex items-center gap-2 bg-dark-surface px-4 py-2 rounded-full border border-dark-border"><span class="text-neon-cyan">✦</span> Web & E-commerce</div>
          <div class="flex items-center gap-2 bg-dark-surface px-4 py-2 rounded-full border border-dark-border"><span class="text-neon-cyan">✦</span> Native Apps (Flutter)</div>
          <div class="flex items-center gap-2 bg-dark-surface px-4 py-2 rounded-full border border-dark-border"><span class="text-neon-purple">✧</span> LLM Integrations (ChatGPT)</div>
          <div class="flex items-center gap-2 bg-dark-surface px-4 py-2 rounded-full border border-dark-border"><span class="text-neon-purple">✧</span> Agentic Commerce (MCP)</div>
        </div>
      </div>
      
      {/* Architecture Infographic */}
      <div class="relative mx-auto w-full max-w-5xl rounded-xl border border-dark-border bg-dark-surface/50 p-2 shadow-2xl backdrop-blur-sm">
        <div class="absolute -top-px left-20 right-11 h-px bg-gradient-to-r from-neon-cyan/0 via-neon-cyan/70 to-neon-purple/0"></div>
        <img src="/rosmarium_infographic.svg" alt="Rosmarium COS Architecture" class="rounded-lg w-full object-cover shadow-inner bg-zinc-900 min-h-[400px]" />
      </div>
    </div>
  </section>

  {/* Feature Grid Section */}
  <section class="py-24 bg-dark-bg border-t border-dark-border relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-3xl md:text-4xl font-bold mb-4">Core Technical Pillars</h2>
        <p class="text-zinc-400">Everything you need to build next-generation AI content applications.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {/* Feature 1 */}
        <div class="p-8 rounded-2xl bg-dark-surface border border-dark-border hover:border-neon-cyan/50 transition-colors group">
          <div class="w-12 h-12 rounded-lg bg-neon-cyan/10 flex items-center justify-center mb-6 group-hover:bg-neon-cyan/20 transition-colors">
            <svg class="w-6 h-6 text-neon-cyan" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-white mb-3">Unify Your Digital Presence</h3>
          <p class="text-zinc-400 leading-relaxed">
            Stop maintaining duplicate content. Write once and publish seamlessly across web, mobile apps, and IoT. Decoupling content from presentation reduces IT overhead by up to 40%.
          </p>
        </div>

        {/* Feature 2 */}
        <div class="p-8 rounded-2xl bg-dark-surface border border-dark-border hover:border-neon-purple/50 transition-colors group">
          <div class="w-12 h-12 rounded-lg bg-neon-purple/10 flex items-center justify-center mb-6 group-hover:bg-neon-purple/20 transition-colors">
            <svg class="w-6 h-6 text-neon-purple" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-white mb-3">Scale Operations with Native AI</h3>
          <p class="text-zinc-400 leading-relaxed">
            Don't pay for bolt-on AI tools. Accelerate your editorial team with built-in semantic tagging, automated summaries, and RAG search out-of-the-box.
          </p>
        </div>

        {/* Feature 3 */}
        <div class="p-8 rounded-2xl bg-dark-surface border border-dark-border hover:border-neon-cyan/50 transition-colors group">
          <div class="w-12 h-12 rounded-lg bg-neon-cyan/10 flex items-center justify-center mb-6 group-hover:bg-neon-cyan/20 transition-colors">
            <svg class="w-6 h-6 text-neon-cyan" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-white mb-3">Ensure Global Compliance</h3>
          <p class="text-zinc-400 leading-relaxed">
            Mitigate regulatory risks instantly. Enforce strict visual approval chains, role-based access controls, and maintain complete audit logs for every editorial action.
          </p>
        </div>

        {/* Feature 4 */}
        <div class="p-8 rounded-2xl bg-dark-surface border border-dark-border hover:border-neon-purple/50 transition-colors group">
          <div class="w-12 h-12 rounded-lg bg-neon-purple/10 flex items-center justify-center mb-6 group-hover:bg-neon-purple/20 transition-colors">
            <svg class="w-6 h-6 text-neon-purple" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-white mb-3">Eliminate Vendor Lock-in</h3>
          <p class="text-zinc-400 leading-relaxed">
            Own your data. Rosmarium is built on fully open-source standards (Node.js, Python, PostgreSQL), giving you complete control over your enterprise infrastructure.
          </p>
        </div>

        {/* Feature 5 */}
        <div class="p-8 rounded-2xl bg-dark-surface border border-dark-border hover:border-neon-cyan/50 transition-colors group">
          <div class="w-12 h-12 rounded-lg bg-neon-cyan/10 flex items-center justify-center mb-6 group-hover:bg-neon-cyan/20 transition-colors">
            <svg class="w-6 h-6 text-neon-cyan" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-white mb-3">Visual Workflow Automation</h3>
          <p class="text-zinc-400 leading-relaxed">
            Stop losing campaigns to miscommunication. Design custom approval chains visually and automate scheduling to ensure your content launches flawlessly, every time.
          </p>
        </div>

        {/* Feature 6 */}
        <div class="p-8 rounded-2xl bg-dark-surface border border-dark-border hover:border-neon-purple/50 transition-colors group">
          <div class="w-12 h-12 rounded-lg bg-neon-purple/10 flex items-center justify-center mb-6 group-hover:bg-neon-purple/20 transition-colors">
            <svg class="w-6 h-6 text-neon-purple" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-white mb-3">Empower Marketing Independence</h3>
          <p class="text-zinc-400 leading-relaxed">
            Give marketers the power to build dynamic landing pages and composite layouts using drag-and-drop blocks, entirely removing developers from the content publishing path.
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* Code Showcase Section */}
  <section class="py-24 relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-b from-dark-bg to-zinc-950 -z-10"></div>
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row items-center gap-12">
        <div class="md:w-1/2">
          <h2 class="text-3xl md:text-4xl font-bold mb-6">Built for Agility.</h2>
          <p class="text-zinc-400 text-lg mb-8 leading-relaxed">
            Give your marketing and engineering teams the freedom to iterate quickly. Rosmarium bridges the gap between powerful developer APIs and intuitive content management tools.
          </p>
          <a href="/docs" class="text-neon-cyan font-semibold hover:underline flex items-center gap-2">
            View the quickstart guide
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>
        
        <div class="md:w-1/2 w-full">
          <div class="rounded-xl overflow-hidden border border-zinc-800 bg-[#0d1117] shadow-2xl">
            <div class="flex items-center px-4 py-3 bg-[#161b22] border-b border-zinc-800">
              <div class="flex gap-2">
                <div class="w-3 h-3 rounded-full bg-red-500"></div>
                <div class="w-3 h-3 rounded-full bg-yellow-500"></div>
                <div class="w-3 h-3 rounded-full bg-green-500"></div>
              </div>
              <div class="mx-auto text-xs text-zinc-500 font-mono">fetch-content.ts</div>
            </div>
            <div class="p-6 overflow-x-auto">
              <pre class="font-mono text-sm leading-relaxed"><code class="language-typescript">
<span class="text-pink-500">import</span> <span class="text-blue-300">{</span> <span class="text-white">RosmariumClient</span> <span class="text-blue-300">}</span> <span class="text-pink-500">from</span> <span class="text-green-300">'@rosmarium/client'</span><span class="text-zinc-500">;</span>

<span class="text-zinc-500">// Initialize the SDK</span>
<span class="text-pink-500">const</span> <span class="text-blue-300">client</span> <span class="text-pink-500">=</span> <span class="text-pink-500">new</span> <span class="text-yellow-200">RosmariumClient</span><span class="text-blue-300">({</span>
  <span class="text-white">apiKey</span><span class="text-pink-500">:</span> process<span class="text-blue-300">.</span>env<span class="text-blue-300">.</span>ROSMARIUM_API_KEY<span class="text-zinc-500">,</span>
<span class="text-blue-300">})</span><span class="text-zinc-500">;</span>

<span class="text-zinc-500">// Perform an AI-powered vector search</span>
<span class="text-pink-500">const</span> <span class="text-blue-300">results</span> <span class="text-pink-500">=</span> <span class="text-pink-500">await</span> client<span class="text-blue-300">.</span>content<span class="text-blue-300">.</span><span class="text-yellow-200">search</span><span class="text-blue-300">({</span>
  <span class="text-white">query</span><span class="text-pink-500">:</span> <span class="text-green-300">"How do I configure RAG?"</span><span class="text-zinc-500">,</span>
  <span class="text-white">mode</span><span class="text-pink-500">:</span> <span class="text-green-300">'hybrid'</span><span class="text-zinc-500">,</span>
  <span class="text-white">limit</span><span class="text-pink-500">:</span> <span class="text-purple-300">5</span>
<span class="text-blue-300">})</span><span class="text-zinc-500">;</span>

<span class="text-yellow-200">console</span><span class="text-blue-300">.</span><span class="text-yellow-200">log</span><span class="text-blue-300">(</span>results<span class="text-blue-300">.</span><span class="text-white">items</span><span class="text-blue-300">)</span><span class="text-zinc-500">;</span>
              </code></pre>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
