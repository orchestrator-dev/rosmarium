---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'The AI-Native Revolution headless CMS' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />
    
    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://rosmarium.com/" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://rosmarium.com/og-image.png" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content="https://rosmarium.com/" />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content="https://rosmarium.com/og-image.png" />

    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="min-h-screen flex flex-col">
    <header class="sticky top-0 z-50 bg-dark-bg/80 backdrop-blur-md border-b border-dark-border">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2">
          <img src="/logo.svg" class="w-8 h-8 drop-shadow-md" alt="Rosmarium Logo" />
          <span class="text-xl font-bold tracking-tight">Rosmarium<span class="text-neon-cyan">.</span></span>
        </a>
        <nav class="hidden md:flex items-center gap-8 text-sm font-medium text-zinc-400">
          <a href="https://demo.rosmarium.com" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors text-neon-purple font-semibold">Demo</a>
          <a href="/docs" class="hover:text-white transition-colors">Docs</a>
          <a href="#" class="hover:text-white transition-colors">Blog</a>
        </nav>
        <div class="flex items-center gap-4">
          <a href="https://github.com/orchestrator-dev/rosmarium" target="_blank" rel="noopener noreferrer" class="text-zinc-400 hover:text-white transition-colors">
            <span class="sr-only">GitHub</span>
            <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
            </svg>
          </a>
        </div>
      </div>
    </header>

    <main class="flex-grow">
      <slot />
    </main>

    <footer class="border-t border-dark-border py-12 mt-24">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 md:grid-cols-4 gap-8">
        <div class="col-span-1 md:col-span-2">
          <a href="/" class="flex items-center gap-2 mb-4">
            <img src="/logo.svg" class="w-6 h-6" alt="Rosmarium Logo" />
            <span class="text-lg font-bold">Rosmarium<span class="text-neon-cyan">.</span></span>
          </a>
          <p class="text-zinc-400 text-sm max-w-sm">
            The open-source, AI-native headless content management system. Built for speed, intelligence, and modern workflows.
          </p>
        </div>
        <div>
          <h3 class="text-sm font-semibold text-white tracking-wider uppercase mb-4">Resources</h3>
          <ul class="space-y-3">
            <li><a href="/docs" class="text-sm text-zinc-400 hover:text-white">Documentation</a></li>
            <li><a href="/docs" class="text-sm text-zinc-400 hover:text-white">API Reference</a></li>
            <li><a href="#" class="text-sm text-zinc-400 hover:text-white">Blog</a></li>
          </ul>
        </div>
        <div>
          <h3 class="text-sm font-semibold text-white tracking-wider uppercase mb-4">Legal</h3>
          <ul class="space-y-3">
            <li><a href="#" class="text-sm text-zinc-400 hover:text-white">Privacy Policy</a></li>
            <li><a href="#" class="text-sm text-zinc-400 hover:text-white">Terms of Service</a></li>
          </ul>
        </div>
      </div>
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-12 pt-8 border-t border-dark-border text-center text-sm text-zinc-500">
        &copy; {new Date().getFullYear()} Rosmarium. All rights reserved.
      </div>
    </footer>
    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const blocks = document.querySelectorAll('pre');
        
        blocks.forEach((block) => {
          // Make sure pre is relative so we can absolute position the button
          if (getComputedStyle(block).position === 'static') {
            block.style.position = 'relative';
          }
          
          const button = document.createElement('button');
          // SVG double square copy icon
          button.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>';
          button.className = 'absolute top-2 right-2 p-2 rounded-md bg-dark-bg/80 text-zinc-400 border border-zinc-700 hover:text-white hover:border-neon-cyan transition-colors opacity-0 focus:opacity-100 backdrop-blur-sm z-10';
          
          // Show on hover
          block.addEventListener('mouseenter', () => button.classList.remove('opacity-0'));
          block.addEventListener('mouseleave', () => button.classList.add('opacity-0'));
          
          button.addEventListener('click', async () => {
            // Get text from the pre code block, excluding the button's own HTML (which is empty anyway in this case)
            const code = block.querySelector('code');
            const textToCopy = code ? code.innerText : block.innerText;
            
            try {
              await navigator.clipboard.writeText(textToCopy);
              // Show checkmark
              button.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#22D3EE" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>';
              button.classList.add('border-neon-cyan');
              
              setTimeout(() => {
                // Revert to copy icon
                button.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>';
                button.classList.remove('border-neon-cyan');
              }, 2000);
            } catch (err) {
              console.error('Failed to copy', err);
            }
          });
          
          block.appendChild(button);
        });
      });
    </script>
  </body>
</html>
